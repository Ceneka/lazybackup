{
  "name": "lazybackup",
  "version": "0.2.7",
  "private": true,
  "license": "MIT",
  "description": "Self-hosted From→To backup manager for paths, Docker volumes, and database dumps between local, SSH, and S3.",
  "homepage": "https://lazy.zic.ar",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ceneka/lazybackup.git"
  },
  "bugs": {
    "url": "https://github.com/Ceneka/lazybackup/issues"
  },
  "keywords": [
    "backup",
    "rsync",
    "self-hosted",
    "docker",
    "s3",
    "postgres",
    "mysql",
    "homelab",
    "mcp",
    "age"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --port ${PORT:-3000}",
    "lint": "next lint",
    "test": "bun test",
    "prepare": "if [ -f scripts/install-git-hooks.sh ]; then sh scripts/install-git-hooks.sh; fi",
    "release": "bun run scripts/cut-release.ts",
    "test:docker": "bash scripts/docker-test.sh",
    "bro:dev": "bun run --cwd bro dev",
    "bro:build": "bun run --cwd bro build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/lib-storage": "^3.1164.0",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@node-rs/argon2": "^2.2.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@smithy/node-http-handler": "^4.14.2",
    "@tanstack/react-query": "^5.107.1",
    "@types/ssh2": "^1.15.6",
    "age-encryption": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron": "^4.4.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.477.0",
    "mcp-handler": "^2.3.1",
    "nanoid": "^5.1.16",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "node-ssh": "^13.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tar-stream": "^3.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.17.23",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "^3.1.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
