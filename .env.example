# Database URL — Next/Bun do not always expand ${VAR}; set the full URL explicitly.
# Local default: file:./data.db
# Docker Compose: file:/app/data/data.db (set in compose; override here only if needed)
DATABASE_URL=file:./data.db

# Host directory bind-mounted into the container at /backups and /app/backups (see docker-compose).
# In backup settings use unique destination paths under /backups/... (new configs default to /backups/<server>/<name>).
BACKUP_STORAGE_PATH=./backups

# Port to run the app on
# default: 3000
PORT=3000

# SSH keys path (Docker mounts this read-only at /root/.ssh)
# default: ~/.ssh
SSH_KEYS_PATH=~/.ssh

# Optional HMAC secret for app-password session cookies.
# If unset, a random sessionSecret is stored in SQLite on first use.
# AUTH_SECRET=

# Set to true only when the UI is served over HTTPS.
# Leave unset/false for plain HTTP (e.g. LAN http://192.168.x.x) or browsers drop the session cookie.
# AUTH_COOKIE_SECURE=true
