# Database file (local). In Docker Compose use /app/data/data.db (or /app/database.db).
DATABASE_FILE=./data.db

# Database URL — Next/Bun do not always expand ${VAR}; set the full URL explicitly.
DATABASE_URL=file:./data.db

# Path to store backups (local). In Docker use /backups or /app/backups.
BACKUP_STORAGE_PATH=./backups

# Port to run the app on
# default: 3000
PORT=3000

# SSH keys path
# default: ~/.ssh
SSH_KEYS_PATH=~/.ssh

